# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Feed (register at https://developer.nationaltransport.ie/) ---
# Same variable names as the project's real .env (used by ingestion/main.py too).
NTA_API_KEY=
NTA_API_KEY_HEADER=x-api-key
NTA_TRIP_UPDATES_URL=https://api.nationaltransport.ie/gtfsr/v2/TripUpdates
NTA_VEHICLE_POSITIONS_URL=https://api.nationaltransport.ie/gtfsr/v2/Vehicles
# NTA fair usage: ONE call per token per 60 s, shared by both feeds -> live mode alternates feeds, so each
# refreshes every 2 cycles (120 s). Values below 60 are raised to 60 in live mode.
POLL_INTERVAL_SECONDS=60

# --- Source mode: "live" hits the real API, "simulator" generates synthetic protobuf ---
FEED_MODE=simulator

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_TRIP_UPDATES=gtfsr.trip_updates
TOPIC_VEHICLE_POSITIONS=gtfsr.vehicle_positions
TOPIC_DELAY_ALERTS=gtfsr.delay_alerts

# --- Alert thresholds (seconds) ---
ALERT_ON_SECONDS=300
ALERT_OFF_SECONDS=120
ALERT_ESCALATION_SECONDS=600,900
ALERT_CONSECUTIVE_OBSERVATIONS=2

# --- Object storage (moto emulator locally, real S3 in AWS: leave S3_ENDPOINT_URL empty) ---
S3_ENDPOINT_URL=http://localhost:5555
S3_BUCKET=gtfsr-lake
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
